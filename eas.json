{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview"
      }
    },
    "apk": {
      "environment": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "production",
        "ANDROID_BUILD_ARCH": "arm64-v8a"
      }
    },
    "apk-armv7": {
      "extends": "apk",
      "env": {
        "ANDROID_BUILD_ARCH": "armeabi-v7a"
      }
    },
    "apk-x86": {
      "extends": "apk",
      "env": {
        "ANDROID_BUILD_ARCH": "x86"
      }
    },
    "apk-x86_64": {
      "extends": "apk",
      "env": {
        "ANDROID_BUILD_ARCH": "x86_64"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "production"
      }
    }
  }
}
